# ====== Porta pública do site (padrão 8580) ======
WEB_PORT=8580

# ====== MySQL (use apenas letras e números nas senhas) ======
# o banco "luana" e as tabelas são criados automaticamente
MYSQL_ROOT_PASSWORD=troque-esta-senha-root
# usuário da aplicação (não use "root")
MYSQL_USER=luana
MYSQL_PASSWORD=troque-esta-senha

# ====== MinIO ======
MINIO_ROOT_USER=luanaminio
# senha com no mínimo 8 caracteres
MINIO_ROOT_PASSWORD=troque-esta-senha-minio
MINIO_BUCKET=luana

# ====== Painel admin ======
ADMIN_EMAIL=admin@luanabaloes.com.br
ADMIN_PASSWORD=troque-esta-senha-admin
# gere com: openssl rand -hex 32
AUTH_SECRET=troque-por-um-segredo-longo

# ====== Apenas para `npm run dev` local (docker-compose.dev.yml) ======
# DB_HOST=localhost
# DB_PORT=8506
# DB_NAME=luana
# DB_USER=luana
# DB_PASSWORD=luana
# MINIO_ENDPOINT=localhost
# MINIO_PORT=8500
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=luana
