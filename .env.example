# ====== Porta pública do site (padrão 80) ======
WEB_PORT=8580

# ====== MongoDB (use apenas letras e números nas senhas) ======
MONGO_USER=luana
MONGO_PASSWORD=troque-esta-senha

# ====== MinIO ======
MINIO_ROOT_USER=luanaminio
# senha com no mínimo 8 caracteres
MINIO_ROOT_PASSWORD=troque-esta-senha-minio
MINIO_BUCKET=luana

# ====== Painel admin ======
ADMIN_EMAIL=admin@luanabaloes.com.br
ADMIN_PASSWORD=troque-esta-senha-admin
# gere com: openssl rand -hex 32
AUTH_SECRET=troque-por-um-segredo-longo

# ====== Apenas para `npm run dev` local (docker-compose.dev.yml) ======
# MONGODB_URI=mongodb://localhost:8517/luana
# MINIO_ENDPOINT=localhost
# MINIO_PORT=8500
# MINIO_USE_SSL=false
# MINIO_ACCESS_KEY=minioadmin
# MINIO_SECRET_KEY=minioadmin
# MINIO_BUCKET=luana
